# Copy to .env (git-ignored) and fill in.
# Unit tests need none of these. Integration tests (`uv run pytest -m integration`) FAIL when a
# variable they need is missing, so an unrun test is visible.

# llm.ClaudeLLM and components.text_to_structured_data.
# Optional on your machine if you are signed in with `ant auth login` (the SDK uses that
# sign-in when no key is set). Needed for unattended runs (CI, cloud jobs). Leave blank otherwise.
ANTHROPIC_API_KEY=

# components.web_scraper: Bright Data fallback backend.
# Create a "Web Unlocker API" zone in the Bright Data dashboard; the API key is under Account.
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# Workflow data locations. Leave blank to use the local, git-ignored defaults:
#   files:    data/storage/<workflow>/
#   database: sqlite:///data/db/<workflow>/<name>.db
# Set them to move a workflow to the cloud, e.g. s3://my-bucket/<workflow> and a Postgres URL.
# Name them <WORKFLOW>_STORAGE_ROOT and <WORKFLOW>_DATABASE_URL, for example:
# HEALTHTECH_MARKET_LANDSCAPE_BOSTON_STORAGE_ROOT=
# HEALTHTECH_MARKET_LANDSCAPE_BOSTON_DATABASE_URL=
# HEALTHTECH_NEWS_EVENTS_STORAGE_ROOT=
# HEALTHTECH_NEWS_EVENTS_DATABASE_URL=

# components.db integration tests: a dedicated test database, never a real one.
# e.g. postgresql+psycopg://postgres:postgres@localhost:5432/workflow_lab_test
TEST_DATABASE_URL=
